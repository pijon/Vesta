rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    // Family membership is proven by the group's memberIds, never by the
    // self-reported users/{uid}.groupId (users can write that field freely).
    function isFamilyMember(targetUserId) {
      let groupId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groupId', null);
      return groupId is string && sharesGroup(groupId, targetUserId);
    }

    function sharesGroup(groupId, targetUserId) {
      let members = get(groupPath(groupId)).data.memberIds;
      return request.auth.uid in members && targetUserId in members;
    }

    function canRead(userId) {
      return isSignedIn() && (request.auth.uid == userId || isFamilyMember(userId));
    }

    // An avatar: a short seed the figure is drawn from, and a metric tint
    function isAvatar(value) {
      return value is map
        && value.keys().hasOnly(['seed', 'tint'])
        && value.seed is string && value.seed.size() > 0 && value.seed.size() <= 64
        && value.tint in ['calories', 'water', 'weight', 'workout', 'fasting'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Push reminder settings and this user's device subscriptions; the scheduled function
    // reads them with admin access
    match /reminders/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User Data
    match /users/{userId} {
      // User profile document - owner only
      allow read, write: if isOwner(userId);

      // Family-readable subcollections, writable by owner only.
      // recipes is legacy: recipes now live in groups/{groupId}/recipes, and members
      // read these once to move them there.
      match /recipes/{recipeId} {
        allow read: if canRead(userId);
        allow write: if isOwner(userId);
      }
      // The name and avatar family members see; everything else about the user stays private
      match /profile/public {
        allow read: if canRead(userId);
        allow write: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['name', 'avatar'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && (!('avatar' in request.resource.data) || isAvatar(request.resource.data.avatar));
      }
      match /days/{document=**} {
        allow read: if canRead(userId);
        allow write: if isOwner(userId);
      }
      match /shopping/{document=**} {
        allow read: if canRead(userId);
        allow write: if isOwner(userId);
      }

      // Owner-only subcollections. data/* holds stats (weight history, goals), fasting,
      // pantry, shopping and coach state.
      match /data/{document=**} {
        allow read, write: if isOwner(userId);
      }
      match /logs/{document=**} {
        allow read, write: if isOwner(userId);
      }
      match /summaries/{document=**} {
        allow read, write: if isOwner(userId);
      }
      match /pantry/{document=**} {
        allow read, write: if isOwner(userId);
      }
      match /fasting/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Groups: Shared Data
    match /groups/{groupId} {
      function isMember() {
        return request.auth.uid in resource.data.memberIds;
      }

      function changesOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      // Adds exactly the requester to memberIds, within the size limit
      // (MAX_FAMILY_GROUP_SIZE in constants.ts).
      function isJoining() {
        let before = resource.data.memberIds;
        let after = request.resource.data.memberIds;
        return !(request.auth.uid in before)
          && request.auth.uid in after
          && after.hasAll(before)
          && after.size() == before.size() + 1
          && after.size() <= 10;
      }

      // Removes exactly the requester from memberIds.
      function isLeaving() {
        let before = resource.data.memberIds;
        let after = request.resource.data.memberIds;
        return request.auth.uid in before
          && !(request.auth.uid in after)
          && before.hasAll(after)
          && after.size() == before.size() - 1;
      }

      // Who manages the family: the owner, or the longest-standing member once the owner has
      // left (familyAdmin in groupService.ts).
      function admin() {
        return resource.data.ownerId in resource.data.memberIds
          ? resource.data.ownerId
          : resource.data.memberIds[0];
      }

      // The admin removes exactly one other member.
      function isRemovingOther() {
        let before = resource.data.memberIds;
        let after = request.resource.data.memberIds;
        return request.auth.uid == admin()
          && request.auth.uid in after
          && before.hasAll(after)
          && after.size() == before.size() - 1;
      }

      // An owner leaving hands the family to a remaining member.
      function isHandingOver() {
        return resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId in request.resource.data.memberIds;
      }

      // Members only. No list: groups are found through groupInvites/{code}.
      allow get: if isSignedIn() && isMember();

      allow create: if isSignedIn()
        && request.resource.data.id == groupId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Anyone holding the groupId may add or remove only themselves (an owner
      // leaving hands the family over); the admin may remove another member;
      // members may rename the group, rotate its invite code or record whose
      // old users/{uid}/recipes have been moved into the family.
      allow update: if isSignedIn() && (
        (changesOnly(['memberIds']) && (isJoining() || isLeaving() || isRemovingOther())) ||
        (changesOnly(['memberIds', 'ownerId']) && isLeaving() && isHandingOver()) ||
        (isMember() && changesOnly(['name', 'inviteCode', 'legacyRecipesMoved']))
      );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;

      // Subcollections (recipes, dinners, departures; shared_recipes is legacy) - members only
      match /{document=**} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(groupPath(groupId)).data.memberIds;
      }

      // Copies of a removed member's recipes, left by the admin (removeMember in
      // groupService.ts). That member collects them after removal, so they may read and
      // delete their own even though they're no longer in memberIds.
      match /departures/{memberId}/recipes/{recipeId} {
        allow read, delete: if isSignedIn() && request.auth.uid == memberId;
      }
    }

    // Invite code -> groupId lookup. Readable by exact code only (no list),
    // so codes cannot be enumerated through a query.
    match /groupInvites/{code} {
      allow get: if isSignedIn();

      // A member publishes the group's current code (batched with the group
      // write, hence getAfter).
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['groupId'])
        && request.auth.uid in getAfter(groupPath(request.resource.data.groupId)).data.memberIds
        && getAfter(groupPath(request.resource.data.groupId)).data.inviteCode == code;

      // A member retires the group's old code when replacing it.
      allow delete: if isSignedIn()
        && request.auth.uid in get(groupPath(resource.data.groupId)).data.memberIds;
    }
  }
}
